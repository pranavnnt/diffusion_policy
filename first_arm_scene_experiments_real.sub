#!/bin/bash
#SBATCH -J dressing_real_first_arm_lr_epoch
#SBATCH -o slurm/slurm_output_%A_%a.out
#SBATCH -e slurm/slurm_error_%A_%a.err
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=8
#SBATCH --requeue
#SBATCH --mem=24G
#SBATCH -t 30:00:00
#SBATCH --partition=gpu
#SBATCH --get-user-env
#SBATCH --gres=gpu:nvidia_rtx_6000_ada_generation:1
#SBATCH --exclude=galhotra-compute-01,thickstun-compute-01
#SBATCH --array=0   # 3 LR × 2 epochs = 6 jobs

export SLURM_ARRAY_TASK_ID=${SLURM_ARRAY_TASK_ID:-0}
export HYDRA_FULL_ERROR=1

echo "Running on $(hostname)"
echo "SLURM_ARRAY_TASK_ID = ${SLURM_ARRAY_TASK_ID}"

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate robodiff

# -------------------- PARAMETER GRID --------------------
LR=(1e-5 5e-5 1e-4)
EPOCHS=(50 150)

NUM_LR=${#LR[@]}
NUM_EPOCHS=${#EPOCHS[@]}

LR_INDEX=$(( SLURM_ARRAY_TASK_ID % NUM_LR ))
EPOCH_INDEX=$(( SLURM_ARRAY_TASK_ID / NUM_LR % NUM_EPOCHS ))

LR_VAL=${LR[$LR_INDEX]}
EPOCH_VAL=${EPOCHS[$EPOCH_INDEX]}

RUN_NAME="left_arm_lr${LR_VAL}_ep${EPOCH_VAL}_${SLURM_ARRAY_TASK_ID}"

echo "Run: ${RUN_NAME}"
echo "LR = ${LR_VAL}"
echo "EPOCHS = ${EPOCH_VAL}"

# -------------------- STAGE DATA TO SCRATCH --------------------
DATA_SRC=/share/bhattacharjee/dressing/demos/thread_arm/real/left/Jan16-20-27_combined_actionfix_upsampled_x2.zarr
DATA_DST=/scratch/pnt8/dressing_demos/real/left
OUTPUT_DST=~/workspace/dressing_sim_ws/diffusion_policy/data/outputs/${RUN_NAME}

mkdir -p "$(dirname ${OUTPUT_DST})"
mkdir -p ${DATA_DST}
cp -r ${DATA_SRC} ${DATA_DST}

cd ~/workspace/dressing_sim_ws/diffusion_policy
echo "Working directory: $(pwd)"

python train.py \
  --config-name=train_diffusion_unet_real_lowdim_workspace_finetune \
  name=${RUN_NAME} \
  task="left_arm" \
  hydra.job.num=${SLURM_ARRAY_TASK_ID} \
  dataloader.num_workers=8 \
  optimizer.lr=${LR_VAL} \
  training.num_epochs=${EPOCH_VAL} \
  training.resume=True

echo "✅ Job ${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID} completed at $(date)"
